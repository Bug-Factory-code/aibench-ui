# 所有配置均有内置默认值（仓库自带 aisbench/ 与数据集），此文件可选。
# 如需覆盖，取消注释并修改。

# aisbench 源码仓库目录（默认使用仓库内 ./aisbench/benchmark）
#AISBENCH_WORK_PATH=/opt/aisbench/benchmark

# prefix 工具目录（默认使用仓库内 ./aisbench/aisbench_auto_tools_prefix）
#PREFIX_TOOL_DIR=/opt/aisbench/aisbench_auto_tools_prefix

#aisbench 执行方式：auto | cli | source | docker（auto 自动降级，docker 零安装）
#AISBENCH_LAUNCH_MODE=auto
#AISBENCH_DOCKER_IMAGE=ghcr.io/aisbench/aisbench_benchmark:v3.1-20260415-master_aarch64_py_310
#AISBENCH_UI_DATASET_DIRS=/data/datasets
#AISBENCH_UI_MAX_PARALLEL=2
#AISBENCH_UI_TASK_TIMEOUT=86400
#AISBENCH_UI_PORT=8001
#AISBENCH_UI_PYTHON=python3
